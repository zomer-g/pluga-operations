# Server environment (copy to .env.server for local development: npm run dev:server)
# On xhostd DATABASE_URL and XHOST_HTTP_PORT are injected by the platform.

DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres?sslmode=disable
NODE_ENV=development
BASE_URL=http://localhost:5201
SESSION_SECRET=change-me-openssl-rand-hex-32

# Google OAuth (Google Cloud Console → Credentials → OAuth client, type "Web application")
# Authorized redirect URI: <BASE_URL>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: only this email may be the very first (admin) user
BOOTSTRAP_ADMIN_EMAIL=
# Optional: "closed" = only users that already exist may sign in
SIGNUP_MODE=open

# Cloudflare R2 (uploaded training files)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Local development only: GET /auth/dev-login signs in as this email without Google
ALLOW_DEV_LOGIN=0
DEV_LOGIN_EMAIL=

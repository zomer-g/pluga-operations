{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "node_modules/vite/bin/vite.js",
        "--port",
        "5201",
        "--strictPort"
      ],
      "port": 5201
    },
    {
      "name": "server",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--env-file=.env.server",
        "server/index.js"
      ],
      "port": 3000
    }
  ]
}
